# Backend public API base (NestJS, global prefix /api)
NEXT_PUBLIC_API_URL=http://localhost:3006/api

# Canonical origin used in JSON-LD and canonical/OG URLs
NEXT_PUBLIC_PUBLIC_BASE_URL=https://biznavigate.com

# Fallback WhatsApp number (country code + number, digits only) used when a
# property has no gupshupSourceNumber
NEXT_PUBLIC_WHATSAPP_DEFAULT=919999999999
